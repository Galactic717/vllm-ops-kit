server {
    listen 443 ssl;
    server_name {{ ops_tls_name }};
    ssl_certificate {{ ops_tls_certificate }};
    ssl_certificate_key {{ ops_tls_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
    allow {{ ops_client_cidr }};
    deny all;

    client_max_body_size 128k;

    location = /health {
        proxy_pass http://127.0.0.1:{{ ops_port }};
    }

    location = /v1/models {
        proxy_pass http://127.0.0.1:{{ ops_port }};
    }

    location = /v1/chat/completions {
        proxy_pass http://127.0.0.1:{{ ops_port }};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 180s;
    }
}
